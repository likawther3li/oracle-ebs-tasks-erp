SQL> SET SERVEROUTPUT ON;
SQL> DECLARE
  2  N NUMBER;
  3  FACT NUMBER :=1;
  4  I NUMBER;
  5  BEGIN
  6  N :=&N;
  7  IF N < 0 THEN
  8  RAISE_APPLICATION_ERROR(-20001, 'NUMBER MUST BE POSITIVE');
  9  END IF;
 10  I :=N;
 11  WHILE I > 0 LOOP
 12  FACT := FACT * I;
 13  I := I - 1;
 14  END LOOP;
 15  DBMS_OUTPUT.PUT_LINE('FACTORIAL OF '||N||' = '||FACT);
 16  EXCEPTION
 17  WHEN OTHERS THEN
 18  DBMS_OUTPUT.PUT_LINE('ERROR: '||SQLERRM);
 19  END;
 20  /
